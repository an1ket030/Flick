# Flick API — Environment Variables
# Copy this file to .env and fill in all values before running.

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://toykeccxzlhvuayeljlb.supabase.co
SUPABASE_ANON_KEY=<your_anon_key>
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>

# ── TMDb ─────────────────────────────────────────────────────
TMDB_API_TOKEN=<your_tmdb_v4_read_access_token>
TMDB_API_KEY=<your_tmdb_v3_api_key>

# ── Upstash Redis ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=<your_upstash_redis_rest_url>
UPSTASH_REDIS_REST_TOKEN=<your_upstash_redis_rest_token>

# ── Gemini ────────────────────────────────────────────────────
GEMINI_API_KEY=<your_gemini_api_key>

# ── Resend ────────────────────────────────────────────────────
RESEND_API_KEY=<your_resend_api_key>

# ── Sentry ────────────────────────────────────────────────────
SENTRY_DSN_API=<your_sentry_node_dsn>

# ── PostHog ───────────────────────────────────────────────────
POSTHOG_API_KEY=<your_posthog_key>
POSTHOG_HOST=https://app.posthog.com

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,exp://localhost:8081
